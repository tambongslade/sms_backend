generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AcademicYear {
  id                           Int                         @id @unique @default(autoincrement())
  name                         String?
  start_date                   DateTime
  end_date                     DateTime
  is_current                   Boolean                     @default(false)
  report_deadline              DateTime?
  created_at                   DateTime                    @default(now())
  updated_at                   DateTime                    @updatedAt
  server_id                    String?
  checksum                     String?
  announcements                Announcement[]
  enrollments                  Enrollment[]
  exam_papers                  ExamPaper[]
  exam_sequences               ExamSequence[]
  generated_reports            GeneratedReport[]
  payment_transactions         PaymentTransaction[]
  school_fees                  SchoolFees[]
  control_payment_transactions ControlPaymentTransaction[]
  control_school_fees          ControlSchoolFees[]
  first_enrollment_students    Student[]                   @relation("StudentFirstEnrollment")
  admitted_students            Student[]                   @relation("StudentAdmissionYear")
  dm_roll_calls                DMRollCall[]
  teacher_roll_calls           TeacherRollCall[]
  teacher_period_attendances   TeacherPeriodAttendance[]
  seized_items                 SeizedItem[]
  teacher_periods              TeacherPeriod[]
  terms                        Term[]
  role_assignments             RoleAssignment[]
  QuizTemplate                 QuizTemplate[]
  QuizSubmission               QuizSubmission[]
  UserRole                     UserRole[]
  fee_items                    FeeItem[]
  subject_schemes              SubjectScheme[]
  salary_profiles              SalaryProfile[]
  pay_periods                  PayPeriod[]
  bursar_cash_injections       BursarCashInjection[]
  period_sets                  PeriodSet[]
}

model User {
  id                                  Int                         @id @unique @default(autoincrement())
  name                                String
  gender                              Gender
  date_of_birth                       DateTime
  photo                               String?
  phone                               String
  whatsapp_number                     String? // For parents communication
  address                             String
  email                               String                      @unique
  password                            String
  id_card_num                         String?
  matricule                           String?                     @unique
  status                              UserStatus                  @default(ACTIVE)
  must_change_password                Boolean                     @default(false) // Force password change on next login (default parents, bursar-created accounts)
  total_hours_per_week                Int? // For teachers
  last_seen_at                        DateTime? // Presence: updated when a chat websocket disconnects
  created_at                          DateTime                    @default(now())
  updated_at                          DateTime                    @updatedAt
  server_id                           String?
  checksum                            String?
  // Relationships
  announcements                       Announcement[]
  discipline_issues_assigned          DisciplineIssue[]           @relation("AssignedDisciplineIssue")
  discipline_issues_reviewed          DisciplineIssue[]           @relation("ReviewedDisciplineIssue")
  marks                               Mark[]                      @relation("RecordedByUser")
  mobile_notifications                MobileNotification[]
  parent_students                     ParentStudent[]
  student_absences                    StudentAbsence[]
  class_master_of                     SubClass[]                  @relation("ClassMaster")
  hod_subjects                        Subject[]                   @relation("HODSubject") // Head of Department
  sub_class_subjects                  SubClassSubject[]
  subject_teachers                    SubjectTeacher[]
  assigned_teacher_absences           TeacherAbsence[]            @relation("AssignedByUser")
  teacher_absences                    TeacherAbsence[]
  assigned_teacher_periods            TeacherPeriod[]             @relation("TeacherPeriods-AssignedBy")
  teacher_periods                     TeacherPeriod[]             @relation("TeacherPeriods-Teacher")
  user_roles                          UserRole[]
  role_assignments                    RoleAssignment[]
  // Communication
  sent_messages                       Message[]                   @relation("SentMessages")
  received_messages                   Message[]                   @relation("ReceivedMessages")
  // Slack-style chat
  chat_channels_created               ChatChannel[]               @relation("ChatChannelCreatedBy")
  chat_memberships                    ChatChannelMember[]
  chat_messages_sent                  ChatMessage[]               @relation("ChatMessageSender")
  chat_reactions                      ChatMessageReaction[]
  chat_mentions                       ChatMessageMention[]
  // Personnel inventory
  inventory_items_created             InventoryItem[]             @relation("InventoryItemCreatedBy")
  inventory_holdings                  InventoryHolding[]
  inventory_transfers_sent            InventoryTransfer[]         @relation("InventoryTransferFrom")
  inventory_transfers_received        InventoryTransfer[]         @relation("InventoryTransferTo")
  inventory_transfers_resolved        InventoryTransfer[]         @relation("InventoryTransferResolvedBy")
  inventory_ledger                    InventoryLedger[]           @relation("InventoryLedgerUser")
  inventory_ledger_acted              InventoryLedger[]           @relation("InventoryLedgerActor")
  // Forms and tracking
  form_submissions                    FormSubmission[]
  audit_logs                          AuditLog[]
  // Fee management
  recorded_payments                   PaymentTransaction[]        @relation("RecordedByUser")
  recorded_control_payments           ControlPaymentTransaction[] @relation("RecordedByUserControl")
  created_fee_items                   FeeItem[]                   @relation("FeeItemCreatedBy")
  recorded_fee_item_payments          FeeItemPayment[]            @relation("FeeItemPaymentRecordedBy")
  recorded_refunds                    Refund[]                    @relation("RefundRecordedBy")
  finance_requests_made               FinanceRequest[]            @relation("FinanceRequestRequestedBy")
  finance_requests_acted              FinanceRequest[]            @relation("FinanceRequestActedBy")
  recorded_expenditures               Expenditure[]               @relation("ExpenditureRecordedBy")
  received_expenditures               Expenditure[]               @relation("ExpenditureRecipient")
  saturday_punishments_assigned       SaturdayPunishment[]        @relation("SaturdayPunishmentAssignedBy")
  broken_properties_reported          BrokenProperty[]            @relation("BrokenPropertyReportedBy")
  disciplinary_actions_decided        DisciplinaryAction[]        @relation("DisciplinaryActionDecidedBy")
  disciplinary_actions_approved       DisciplinaryAction[]        @relation("DisciplinaryActionApprover")
  report_requests_sent                ReportRequest[]             @relation("ReportRequestRequestedBy")
  report_requests_received            ReportRequest[]             @relation("ReportRequestRequestedFrom")
  QuizTemplate                        QuizTemplate[]
  QuizSubmission                      QuizSubmission[]
  created_subject_schemes             SubjectScheme[]             @relation("SubjectSchemeCreatedBy")
  logbook_entries_taught              LogbookEntry[]              @relation("LogbookEntryTaughtBy")
  logbook_entries_reviewed            LogbookEntry[]              @relation("LogbookEntryReviewedBy")
  // Discipline extensions
  absences_excused                    StudentAbsence[]            @relation("AbsenceExcusedByParent")
  absence_makeups_verified            StudentAbsence[]            @relation("AbsenceMakeupVerifiedBy")
  student_warnings_issued             StudentWarning[]            @relation("WarningIssuedBy")
  parent_summons_as_parent            ParentSummons[]             @relation("SummonsParent")
  parent_summons_created              ParentSummons[]             @relation("SummonsCreatedBy")
  dm_roll_calls_recorded              DMRollCall[]                @relation("DMRollCallRecordedBy")
  teacher_roll_calls_recorded         TeacherRollCall[]           @relation("TeacherRollCallRecordedBy")
  teacher_period_attendances_recorded TeacherPeriodAttendance[]   @relation("TeacherPeriodAttendanceRecordedBy")
  seized_items_seized                 SeizedItem[]                @relation("SeizedItemSeizedBy")
  seized_items_in_custody             SeizedItem[]                @relation("SeizedItemCustodian")
  seized_items_released_to            SeizedItem[]                @relation("SeizedItemReleasedTo")
  seized_item_transfers_sent          SeizedItemTransfer[]        @relation("SeizedItemTransferFrom")
  seized_item_transfers_received      SeizedItemTransfer[]        @relation("SeizedItemTransferTo")
  seized_item_transfers_resolved      SeizedItemTransfer[]        @relation("SeizedItemTransferResolvedBy")
  // Nurse
  nurse_visit_logs                    NurseVisitLog[]             @relation("NurseVisitLoggedBy")
  // Ream (paper) stock
  ream_ledger_recorded                ReamStockLedger[]           @relation("ReamStockLedgerRecordedBy")
  ream_ledger_received                ReamStockLedger[]           @relation("ReamStockLedgerRecipient")
  // Notifications: sender side (recipient side already covered by `mobile_notifications`)
  notifications_sent                  MobileNotification[]        @relation("NotificationSender")
  // Tasks
  tasks_assigned_to                   Task[]                      @relation("TaskAssignedTo")
  tasks_assigned_by                   Task[]                      @relation("TaskAssignedBy")
  // Salary management
  salary_profile                      SalaryProfile[]             @relation("SalaryProfileUser")
  salary_profiles_created             SalaryProfile[]             @relation("SalaryProfileCreatedBy")
  salary_profiles_approved            SalaryProfile[]             @relation("SalaryProfileApprovedBy")
  salary_change_requests_made         SalaryChangeRequest[]       @relation("SalaryChangeRequestRequestedBy")
  salary_change_requests_acted        SalaryChangeRequest[]       @relation("SalaryChangeRequestApprovedBy")
  salary_allowances_requested         SalaryAllowance[]           @relation("SalaryAllowanceRequestedBy")
  salary_allowances_approved          SalaryAllowance[]           @relation("SalaryAllowanceApprovedBy")
  pay_periods_created                 PayPeriod[]                 @relation("PayPeriodCreatedBy")
  salary_payments                     SalaryPayment[]             @relation("SalaryPaymentUser")
  salary_payments_paid                SalaryPayment[]             @relation("SalaryPaymentPaidBy")
  salary_withholdings_requested       SalaryWithholding[]         @relation("SalaryWithholdingRequestedBy")
  salary_withholdings_approved        SalaryWithholding[]         @relation("SalaryWithholdingApprovedBy")
  bursar_cash_injections              BursarCashInjection[]       @relation("BursarCashInjectedBy")
  // Staff loans + leave
  loans_requested                     StaffLoan[]                 @relation("StaffLoanBorrower")
  loans_approved                      StaffLoan[]                 @relation("StaffLoanApprover")
  loan_repayments_recorded            StaffLoanRepayment[]        @relation("StaffLoanRepaymentRecordedBy")
  leave_requested                     LeaveRequest[]              @relation("LeaveRequestRequester")
  leave_approved                      LeaveRequest[]              @relation("LeaveRequestApprover")
  // Per-user preferences (theme, language, notification toggles, quiet hours)
  settings                            UserSettings?
}

model UserSettings {
  id                   Int                    @id @default(autoincrement())
  user_id              Int                    @unique
  theme                Theme                  @default(SYSTEM)
  language             String                 @default("en")
  timezone             String                 @default("Africa/Douala")
  notifications_email  Boolean                @default(true)
  notifications_sms    Boolean                @default(false)
  notifications_push   Boolean                @default(true)
  notifications_in_app Boolean                @default(true)
  quiet_hours_enabled  Boolean                @default(false)
  quiet_hours_start    String? // HH:MM 24h
  quiet_hours_end      String? // HH:MM 24h
  muted_categories     NotificationCategory[] @default([])
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model UserRole {
  id               Int           @id @default(autoincrement())
  user_id          Int
  role             Role
  academic_year_id Int? // Nullable for global roles like SUPER_MANAGER
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  server_id        String?
  checksum         String?
  user             User          @relation(fields: [user_id], references: [id])
  academic_year    AcademicYear? @relation(fields: [academic_year_id], references: [id])

  @@unique([user_id, role, academic_year_id], name: "user_id_role_academic_year")
}

// Simplified assignment table replacing multiple assignment tables
model RoleAssignment {
  id               Int            @id @default(autoincrement())
  user_id          Int
  academic_year_id Int
  role_type        AssignmentRole
  sub_class_id     Int? // For VP and SDM assignments
  subject_id       Int? // For HOD assignments
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  server_id        String?
  checksum         String?
  academic_year    AcademicYear   @relation(fields: [academic_year_id], references: [id])
  user             User           @relation(fields: [user_id], references: [id])
  sub_class        SubClass?      @relation(fields: [sub_class_id], references: [id])
  subject          Subject?       @relation(fields: [subject_id], references: [id])

  @@unique([user_id, role_type, academic_year_id, sub_class_id, subject_id])
}

model ParentStudent {
  id           Int           @id @default(autoincrement())
  parent_id    Int
  student_id   Int
  relationship Relationship?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  server_id    String?
  checksum     String?
  parent       User          @relation(fields: [parent_id], references: [id])
  student      Student       @relation("StudentParents", fields: [student_id], references: [id])

  @@unique([parent_id, student_id])
}

model Class {
  id                Int             @id @unique @default(autoincrement())
  name              String
  max_students      Int             @default(80) // Maximum 80 students per class
  pass_mark         Float           @default(10.0) // Minimum annual average to be promoted to next_class
  next_class_id     Int? // Linear progression target; null = terminal (graduates) or manual choice (e.g. FORM 5 → arts/science)
  // Which bell schedule the class follows. Nullable so legacy classes without an
  // assignment continue to render, but /timetables/subclass and bulk-update
  // require it before slots can be assigned. Reassigning is one row update.
  period_set_id     Int?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  server_id         String?
  checksum          String?
  // Simplified fee structure
  base_fee          Float           @default(0)
  miscellaneous_fee Float           @default(0)
  new_student_fee   Float           @default(0)
  old_student_fee   Float           @default(0)
  first_term_fee    Float           @default(0)
  second_term_fee   Float           @default(0)
  third_term_fee    Float           @default(0)
  sub_classes       SubClass[]
  Enrollment        Enrollment[]
  next_class        Class?          @relation("ClassProgression", fields: [next_class_id], references: [id])
  previous_classes  Class[]         @relation("ClassProgression")
  fee_items         FeeItem[]
  subject_schemes   SubjectScheme[]
  period_set        PeriodSet?      @relation(fields: [period_set_id], references: [id])
  term_classes      TermClass[]
}

model SubClass {
  id                 Int               @id @unique @default(autoincrement())
  name               String
  current_students   Int               @default(0) // Track current enrollment
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  server_id          String?
  checksum           String?
  class_id           Int
  class_master_id    Int?
  enrollments        Enrollment[]
  generated_reports  GeneratedReport[]
  class              Class             @relation(fields: [class_id], references: [id])
  class_master       User?             @relation("ClassMaster", fields: [class_master_id], references: [id])
  sub_class_subjects SubClassSubject[]
  teacher_periods    TeacherPeriod[]
  role_assignments   RoleAssignment[]
  fee_items          FeeItem[]
  dm_roll_calls      DMRollCall[]
}

model Student {
  id                         Int                     @id @unique @default(autoincrement())
  matricule                  String                  @unique
  name                       String
  nom                        String?
  prenom                     String?
  date_of_birth              DateTime
  place_of_birth             String
  gender                     Gender
  residence                  String
  former_school              String?
  is_new_student             Boolean                 @default(true) // Track new vs old students
  status                     StudentStatus           @default(NOT_ENROLLED) // Track enrollment status
  first_enrollment_year_id   Int?
  admission_academic_year_id Int? // User-selectable admission year (independent of first_enrollment_year_id)
  health_conditions          HealthCondition[]       @default([])
  medical_notes              String?
  created_at                 DateTime                @default(now())
  updated_at                 DateTime                @updatedAt
  server_id                  String?
  checksum                   String?
  enrollments                Enrollment[]
  generated_reports          GeneratedReport[]
  parents                    ParentStudent[]         @relation("StudentParents")
  first_enrollment_year      AcademicYear?           @relation("StudentFirstEnrollment", fields: [first_enrollment_year_id], references: [id])
  admission_academic_year    AcademicYear?           @relation("StudentAdmissionYear", fields: [admission_academic_year_id], references: [id])
  previous_schools           StudentPreviousSchool[]
  interview_marks            InterviewMark[] // VP interview marks
  fee_items                  FeeItem[]               @relation("StudentFeeItems")
  QuizSubmission             QuizSubmission[]
}

model StudentPreviousSchool {
  id          Int      @id @default(autoincrement())
  student_id  Int
  school_name String
  from_year   String?
  to_year     String?
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  student     Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  server_id   String?
  checksum    String?

  @@index([student_id])
}

model Enrollment {
  id                           Int                         @id @default(autoincrement())
  student_id                   Int
  academic_year_id             Int
  class_id                     Int // Initial class assignment (required)
  repeater                     Boolean                     @default(false)
  photo                        String?
  ream_of_paper_collected      Boolean                     @default(false) // Confirms ream-of-paper collection (typically for new students)
  enrollment_date              DateTime                    @default(now())
  created_at                   DateTime                    @default(now())
  updated_at                   DateTime                    @updatedAt
  server_id                    String?
  checksum                     String?
  sub_class_id                 Int? // Subclass assignment after interview (optional)
  discipline_issues            DisciplineIssue[]
  academic_year                AcademicYear                @relation(fields: [academic_year_id], references: [id])
  student                      Student                     @relation(fields: [student_id], references: [id])
  class                        Class                       @relation(fields: [class_id], references: [id])
  sub_class                    SubClass?                   @relation(fields: [sub_class_id], references: [id])
  marks                        Mark[]
  payment_transactions         PaymentTransaction[]
  school_fees                  SchoolFees[]
  control_payment_transactions ControlPaymentTransaction[]
  control_school_fees          ControlSchoolFees[]
  absences                     StudentAbsence[]
  student_sequence_averages    StudentSequenceAverage[]
  fee_item_payments            FeeItemPayment[]
  refunds                      Refund[]
  saturday_punishments         SaturdayPunishment[]
  broken_properties            BrokenProperty[]
  disciplinary_actions         DisciplinaryAction[]
  student_warnings             StudentWarning[]
  parent_summons               ParentSummons[]
  dm_roll_call_entries         DMRollCallEntry[]
  teacher_roll_call_entries    TeacherRollCallEntry[]
  seized_items                 SeizedItem[]
  nurse_visit_logs             NurseVisitLog[]

  @@unique([student_id, academic_year_id])
  @@index([sub_class_id, academic_year_id])
}

model SchoolFees {
  id                   Int                  @id @default(autoincrement())
  amount_expected      Float
  amount_paid          Float                @default(0)
  academic_year_id     Int
  due_date             DateTime
  enrollment_id        Int
  is_new_student       Boolean              @default(false) // Different fees for new/old
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  server_id            String?
  checksum             String?
  payment_transactions PaymentTransaction[]
  refunds              Refund[]
  academic_year        AcademicYear         @relation(fields: [academic_year_id], references: [id])
  enrollment           Enrollment           @relation(fields: [enrollment_id], references: [id])

  @@unique([enrollment_id, academic_year_id])
}

model ControlSchoolFees {
  id                           Int                         @id @default(autoincrement())
  amount_expected              Float
  amount_paid                  Float                       @default(0)
  academic_year_id             Int
  due_date                     DateTime
  enrollment_id                Int
  is_new_student               Boolean                     @default(false) // Different fees for new/old
  created_at                   DateTime                    @default(now())
  updated_at                   DateTime                    @updatedAt
  control_payment_transactions ControlPaymentTransaction[]
  academic_year                AcademicYear                @relation(fields: [academic_year_id], references: [id])
  enrollment                   Enrollment                  @relation(fields: [enrollment_id], references: [id])
  server_id                    String?
  checksum                     String?

  @@unique([enrollment_id, academic_year_id])
}

model Subject {
  id                 Int               @id @unique @default(autoincrement())
  name               String
  category           SubjectCategory
  hod_id             Int? // Head of Department
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  server_id          String?
  checksum           String?
  hod                User?             @relation("HODSubject", fields: [hod_id], references: [id])
  exam_papers        ExamPaper[]
  questions          Question[]
  sub_class_subjects SubClassSubject[]
  subject_teachers   SubjectTeacher[]
  teacher_periods    TeacherPeriod[]
  role_assignments   RoleAssignment[]
  QuizTemplate       QuizTemplate[]
  subject_schemes    SubjectScheme[]
  chat_channels      ChatChannel[]
}

model SubClassSubject {
  id           Int      @id @default(autoincrement())
  coefficient  Float
  sub_class_id Int
  subject_id   Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  server_id    String?
  checksum     String?
  userId       Int?
  marks        Mark[]
  sub_class    SubClass @relation(fields: [sub_class_id], references: [id])
  subject      Subject  @relation(fields: [subject_id], references: [id])
  User         User?    @relation(fields: [userId], references: [id])

  @@unique([sub_class_id, subject_id])
}

model SubjectTeacher {
  id         Int      @id @default(autoincrement())
  subject_id Int
  teacher_id Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  server_id  String?
  checksum   String?
  subject    Subject  @relation(fields: [subject_id], references: [id])
  teacher    User     @relation(fields: [teacher_id], references: [id])

  @@unique([subject_id, teacher_id])
}

model DisciplineIssue {
  id                   Int                  @id @unique @default(autoincrement())
  enrollment_id        Int
  issue_type           DisciplineType
  description          String
  notes                String?
  action_taken         String?
  assigned_by_id       Int
  reviewed_by_id       Int
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  assigned_by          User                 @relation("AssignedDisciplineIssue", fields: [assigned_by_id], references: [id])
  enrollment           Enrollment           @relation(fields: [enrollment_id], references: [id])
  reviewed_by          User                 @relation("ReviewedDisciplineIssue", fields: [reviewed_by_id], references: [id])
  disciplinary_actions DisciplinaryAction[]
  server_id            String?
  checksum             String?
}

model StudentAbsence {
  id                        Int                    @id @default(autoincrement())
  assigned_by_id            Int
  teacher_period_id         Int?
  enrollment_id             Int
  absence_type              AbsenceType            @default(CLASS_ABSENCE)
  // Parent-side excuse (justification). Excused absences don't count toward warning/summons thresholds.
  is_excused                Boolean                @default(false)
  excused_by_parent_id      Int?
  excused_at                DateTime?
  excuse_reason             String?
  // Student-side makeup (independent of excuse). Tracked separately for academic recovery.
  makeup_status             MakeupStatus           @default(NONE)
  makeup_completed_at       DateTime?
  makeup_notes              String?
  makeup_verified_by_id     Int?
  created_at                DateTime               @default(now())
  updated_at                DateTime               @updatedAt
  server_id                 String?
  checksum                  String?
  assigned_by               User                   @relation(fields: [assigned_by_id], references: [id])
  enrollment                Enrollment             @relation(fields: [enrollment_id], references: [id])
  teacher_period            TeacherPeriod?         @relation(fields: [teacher_period_id], references: [id])
  excused_by                User?                  @relation("AbsenceExcusedByParent", fields: [excused_by_parent_id], references: [id])
  makeup_verified_by        User?                  @relation("AbsenceMakeupVerifiedBy", fields: [makeup_verified_by_id], references: [id])
  dm_roll_call_entries      DMRollCallEntry[]      @relation("DMRollCallAbsence")
  teacher_roll_call_entries TeacherRollCallEntry[] @relation("TeacherRollCallAbsence")

  @@unique([enrollment_id, teacher_period_id])
  @@index([enrollment_id, is_excused, absence_type])
}

model TeacherAbsence {
  id                Int            @id @default(autoincrement())
  reason            String
  teacher_id        Int
  assigned_by_id    Int
  teacher_period_id Int?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  server_id         String?
  checksum          String?
  assigned_by       User           @relation("AssignedByUser", fields: [assigned_by_id], references: [id])
  teacher           User           @relation(fields: [teacher_id], references: [id])
  teacher_period    TeacherPeriod? @relation(fields: [teacher_period_id], references: [id])

  @@unique([teacher_id, teacher_period_id])
}

model ExamSequence {
  id                        Int                      @id @default(autoincrement())
  sequence_number           Int
  academic_year_id          Int
  term_id                   Int
  submission_deadline       DateTime?
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt
  server_id                 String?
  checksum                  String?
  status                    ExamSequenceStatus       @default(OPEN)
  academic_year             AcademicYear             @relation(fields: [academic_year_id], references: [id])
  term                      Term                     @relation(fields: [term_id], references: [id])
  generated_reports         GeneratedReport[]
  marks                     Mark[]
  student_sequence_averages StudentSequenceAverage[]

  @@unique([sequence_number, term_id, academic_year_id])
}

model Term {
  id               Int            @id @default(autoincrement())
  name             String
  start_date       DateTime?
  end_date         DateTime?
  academic_year_id Int?
  fee_deadline     DateTime?
  // Marks the term as a holiday period rather than a teaching term. Holiday
  // terms scope through TermClass so only the affected classes see them.
  is_holiday       Boolean        @default(false)
  // Timestamps added for sync: getLocalChanges selects on updated_at, so a
  // table without it cannot participate in the sync at all.
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  server_id        String?
