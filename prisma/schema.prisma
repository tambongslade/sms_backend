  academic_year_id Int
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  subject       Subject          @relation(fields: [subject_id], references: [id])
  academic_year AcademicYear     @relation(fields: [academic_year_id], references: [id])
  created_by    User             @relation(fields: [created_by_id], references: [id])
  questions     QuizQuestion[]
  submissions   QuizSubmission[]
  server_id     String?
  checksum      String?

  @@index([subject_id])
  @@index([academic_year_id])
  @@index([is_active])
}

model QuizQuestion {
  id             Int          @id @default(autoincrement())
  quiz_id        Int
  question_text  String
  question_type  QuestionType @default(MCQ)
  options        Json? // Array of options for MCQ
  correct_answer String
  marks          Int          @default(1)
  order_index    Int
  explanation    String?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  quiz      QuizTemplate   @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  responses QuizResponse[]
  server_id String?
  checksum  String?

  @@index([quiz_id])
}

model QuizSubmission {
  id               Int        @id @default(autoincrement())
  quiz_id          Int
  student_id       Int
  parent_id        Int // Parent who supervised the quiz
  score            Int?
  total_marks      Int
  percentage       Float?
  time_taken       Int? // Minutes taken
  status           QuizStatus @default(IN_PROGRESS)
  started_at       DateTime   @default(now())
  submitted_at     DateTime?
  academic_year_id Int
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  quiz          QuizTemplate   @relation(fields: [quiz_id], references: [id])
  student       Student        @relation(fields: [student_id], references: [id])
  parent        User           @relation(fields: [parent_id], references: [id])
  academic_year AcademicYear   @relation(fields: [academic_year_id], references: [id])
  responses     QuizResponse[]
  server_id     String?
  checksum      String?

  @@unique([quiz_id, student_id, academic_year_id])
  @@index([quiz_id])
  @@index([student_id])
  @@index([parent_id])
}

model QuizResponse {
  id            Int      @id @default(autoincrement())
  submission_id Int
  question_id   Int
  answer        String
  is_correct    Boolean?
  marks_awarded Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  submission QuizSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  question   QuizQuestion   @relation(fields: [question_id], references: [id])
  server_id  String?
  checksum   String?

  @@index([submission_id])
  @@index([question_id])
}

enum QuizStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  GRADED
  EXPIRED
}

// Sync-related models
model SyncMetadata {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  server_type String // 'local' or 'remote'
  server_id   String?
  created_at  DateTime @default(now())
}

model SyncLog {
  id                Int       @id @default(autoincrement())
  sync_id           String
  start_time        DateTime
  end_time          DateTime?
  status            String // PENDING, IN_PROGRESS, COMPLETED, FAILED
  direction         String // PUSH, PULL, BIDIRECTIONAL
  records_processed Int       @default(0)
  conflicts         String? // JSON string
  errors            String? // JSON string
  created_at        DateTime  @default(now())

  @@index([sync_id])
  @@index([start_time])
}

// Bursar-defined ad-hoc fees (e.g. GCE, trips, uniforms) scoped to all/a class/a subclass.
// When requires_school_fees_paid = true, any payment first cascades into outstanding school fees.
model FeeItem {
  id                        Int              @id @default(autoincrement())
  name                      String
  description               String?
  amount                    Float
  academic_year_id          Int
  scope                     FeeItemScope
  class_id                  Int? // populated when scope = CLASS
  sub_class_id              Int? // populated when scope = SUBCLASS
  student_id                Int? // populated when scope = STUDENT
  requires_school_fees_paid Boolean          @default(false)
  is_active                 Boolean          @default(true)
  created_by_id             Int
  created_at                DateTime         @default(now())
  updated_at                DateTime         @updatedAt
  academic_year             AcademicYear     @relation(fields: [academic_year_id], references: [id])
  class                     Class?           @relation(fields: [class_id], references: [id])
  sub_class                 SubClass?        @relation(fields: [sub_class_id], references: [id])
  student                   Student?         @relation("StudentFeeItems", fields: [student_id], references: [id])
  created_by                User             @relation("FeeItemCreatedBy", fields: [created_by_id], references: [id])
  payments                  FeeItemPayment[]
  broken_property           BrokenProperty?
  server_id                 String?
  checksum                  String?

  @@index([academic_year_id, is_active])
  @@index([scope, class_id, sub_class_id])
  @@index([scope, student_id])
}

// One row per actual payment recorded against a FeeItem.
// Use this ledger to compute paid-so-far per (enrollment, fee_item).
model FeeItemPayment {
  id                      Int           @id @default(autoincrement())
  fee_item_id             Int
  enrollment_id           Int
  amount                  Float
  payment_date            DateTime
  receipt_number          String?
  payment_method          PaymentMethod
  recorded_by_id          Int
  notes                   String?
  cascaded_to_school_fees Boolean       @default(false) // True when the payment was redirected to SchoolFees by the cascade rule
  school_fees_payment_id  Int? // FK to PaymentTransaction created during cascade
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt
  fee_item                FeeItem       @relation(fields: [fee_item_id], references: [id])
  enrollment              Enrollment    @relation(fields: [enrollment_id], references: [id])
  recorded_by             User          @relation("FeeItemPaymentRecordedBy", fields: [recorded_by_id], references: [id])
  server_id               String?
  checksum                String?

  @@index([fee_item_id, enrollment_id])
  @@index([enrollment_id])
}

enum FeeItemScope {
  ALL
  CLASS
  SUBCLASS
  STUDENT
}

// Refunds against SchoolFees overpayments. Recording a refund decrements
// SchoolFees.amount_paid atomically. Immutable once recorded — corrections
// use a counter-refund (or a Principal-only void endpoint if added later).
model Refund {
  id             Int          @id @default(autoincrement())
  enrollment_id  Int
  school_fees_id Int
  amount         Float
  refund_date    DateTime
  refund_method  RefundMethod
  reason         String
  notes          String?
  recorded_by_id Int
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  enrollment     Enrollment   @relation(fields: [enrollment_id], references: [id])
  school_fees    SchoolFees   @relation(fields: [school_fees_id], references: [id])
  recorded_by    User         @relation("RefundRecordedBy", fields: [recorded_by_id], references: [id])
  server_id      String?
  checksum       String?

  @@index([enrollment_id])
  @@index([school_fees_id])
  @@index([refund_date])
}

enum RefundMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  EXPRESS_UNION
  CCA
  F3DC
  AFRILAND_FIRST_BANK
}

// Saturday punishment scheduled by the DM, typically after 3 lates in a term.
// Lifecycle: PENDING -> SERVED or SKIPPED.
model SaturdayPunishment {
  id              Int                        @id @default(autoincrement())
  enrollment_id   Int
  reason          String
  reason_category SaturdayPunishmentCategory @default(STANDARD)
  scheduled_date  DateTime?
  served_date     DateTime?
  status          PunishmentStatus           @default(PENDING)
  notes           String?
  assigned_by_id  Int
  created_at      DateTime                   @default(now())
  updated_at      DateTime                   @updatedAt
  enrollment      Enrollment                 @relation(fields: [enrollment_id], references: [id])
  assigned_by     User                       @relation("SaturdayPunishmentAssignedBy", fields: [assigned_by_id], references: [id])
  server_id       String?
  checksum        String?

  @@index([enrollment_id, status])
  @@index([status, scheduled_date])
}

enum SaturdayPunishmentCategory {
  STANDARD
  CUSTOM
  EXTRAORDINARY
}

// Progressive warning issued to a student. Auto-created by
// disciplineService.evaluateAbsenceTriggers when cumulative unexcused
// absences cross the [3, 6, 9] thresholds; may also be issued manually.
model StudentWarning {
  id                    Int           @id @default(autoincrement())
  enrollment_id         Int
  warning_level         Int
  reason                WarningReason
  description           String
  trigger_absence_count Int?
  issued_by_id          Int
  resolved              Boolean       @default(false)
  resolved_at           DateTime?
  resolved_notes        String?
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt
  enrollment            Enrollment    @relation(fields: [enrollment_id], references: [id])
  issued_by             User          @relation("WarningIssuedBy", fields: [issued_by_id], references: [id])
  server_id             String?
  checksum              String?

  @@index([enrollment_id, resolved])
  @@index([enrollment_id, warning_level])
}

// Parent summons record. Auto-created by
// disciplineService.evaluateAbsenceTriggers on 3 consecutive unexcused
// absences or 6 cumulative unexcused absences in a term; also created
// manually by DM/admins. Cancelled (never deleted) when triggers reverse
// after excusing absences, preserving the audit trail.
model ParentSummons {
  id                  Int            @id @default(autoincrement())
  enrollment_id       Int
  parent_id           Int?
  reason              String
  trigger_type        SummonsTrigger
  trigger_absence_ids Int[]          @default([])
  scheduled_date      DateTime?
  status              SummonsStatus  @default(PENDING)
  meeting_notes       String?
  attended            Boolean?
  created_by_id       Int
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt
  enrollment          Enrollment     @relation(fields: [enrollment_id], references: [id])
  parent              User?          @relation("SummonsParent", fields: [parent_id], references: [id])
  created_by          User           @relation("SummonsCreatedBy", fields: [created_by_id], references: [id])
  server_id           String?
  checksum            String?

  @@index([enrollment_id, status])
  @@index([status, scheduled_date])
}

// DM roll call at 3 fixed daily slots (2nd/5th/8th period bell).
// Independent of the Period model; slot is a fixed conceptual marker.
model DMRollCall {
  id               Int               @id @default(autoincrement())
  sub_class_id     Int
  academic_year_id Int
  date             DateTime
  slot             RollCallSlot
  recorded_by_id   Int
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  sub_class        SubClass          @relation(fields: [sub_class_id], references: [id])
  academic_year    AcademicYear      @relation(fields: [academic_year_id], references: [id])
  recorded_by      User              @relation("DMRollCallRecordedBy", fields: [recorded_by_id], references: [id])
  entries          DMRollCallEntry[]
  server_id        String?
  checksum         String?

  @@unique([sub_class_id, date, slot])
  @@index([academic_year_id, date])
}

model DMRollCallEntry {
  id                Int              @id @default(autoincrement())
  dm_roll_call_id   Int
  enrollment_id     Int
  status            DMRollCallStatus
  linked_absence_id Int?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  dm_roll_call      DMRollCall       @relation(fields: [dm_roll_call_id], references: [id], onDelete: Cascade)
  enrollment        Enrollment       @relation(fields: [enrollment_id], references: [id])
  linked_absence    StudentAbsence?  @relation("DMRollCallAbsence", fields: [linked_absence_id], references: [id])
  server_id         String?
  checksum          String?

  @@unique([dm_roll_call_id, enrollment_id])
  @@index([enrollment_id])
}

// Damage logged by the DM. Auto-creates a STUDENT-scoped FeeItem
// so the bursar sees the charge on the student's outstanding fees.
model BrokenProperty {
  id             Int        @id @default(autoincrement())
  enrollment_id  Int
  item_name      String
  description    String
  estimated_cost Float?
  photo_url      String?
  action_taken   String?
  fee_item_id    Int?       @unique
  reported_by_id Int
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
  enrollment     Enrollment @relation(fields: [enrollment_id], references: [id])
  fee_item       FeeItem?   @relation(fields: [fee_item_id], references: [id])
  reported_by    User       @relation("BrokenPropertyReportedBy", fields: [reported_by_id], references: [id])
  server_id      String?
  checksum       String?

  @@index([enrollment_id])
  @@index([reported_by_id])
}

// Nurse-visit log: a student came to the infirmary. Only reason is required;
// the period, treatment, medication and notes are all optional so the nurse
// can capture a quick entry and fill in details later.
model NurseVisitLog {
  id               Int        @id @default(autoincrement())
  enrollment_id    Int
  period_id        Int?
  visit_date       DateTime   @default(now())
  reason           String
  treatment_given  String?
  medication_given String?
  notes            String?
  sent_home        Boolean    @default(false)
  logged_by_id     Int
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  enrollment       Enrollment @relation(fields: [enrollment_id], references: [id])
  period           Period?    @relation(fields: [period_id], references: [id])
  logged_by        User       @relation("NurseVisitLoggedBy", fields: [logged_by_id], references: [id])
  server_id        String?
  checksum         String?

  @@index([enrollment_id])
  @@index([logged_by_id])
  @@index([visit_date])
}

// Generic bursar-initiated request that needs an action by someone else:
// FEE_REDUCTION (Principal approves/rejects, manual fee adjustment after),
// PERSONNEL_DISBURSEMENT (recipient confirms receipt),
// BANK_VERIFICATION (whoever goes to the bank marks completed once checked),
// PAYMENT_CLAIM (parent/user submits proof of a payment; Bursar validates → creates PaymentTransaction),
// REFUND (Bursar initiates a refund on overpayment; Super Manager approves → creates Refund).
model FinanceRequest {
  id              Int                  @id @default(autoincrement())
  type            FinanceRequestType
  status          FinanceRequestStatus @default(PENDING)
  amount          Float? // null for BANK_VERIFICATION
  reason          String
  notes           String?
  payload         Json // type-specific fields
  requested_by_id Int
  acted_by_id     Int?
  acted_at        DateTime?
  acted_notes     String?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  requested_by    User                 @relation("FinanceRequestRequestedBy", fields: [requested_by_id], references: [id])
  acted_by        User?                @relation("FinanceRequestActedBy", fields: [acted_by_id], references: [id])
  server_id       String?
  checksum        String?

  @@index([type, status])
  @@index([requested_by_id])
  @@index([created_at])
}

enum FinanceRequestType {
  FEE_REDUCTION
  PERSONNEL_DISBURSEMENT
  BANK_VERIFICATION
  PAYMENT_CLAIM
  REFUND
}

enum FinanceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// Free-form expense ledger. No approval workflow — Bursar records what was spent.
// Edit rules enforced in service: Bursar can edit her own within 7 days; Principal+ anytime.
model Expenditure {
  id                Int                 @id @default(autoincrement())
  date              DateTime
  category          ExpenditureCategory
  description       String
  amount            Float
  recipient         String? // free text vendor / person name
  recipient_user_id Int? // optional FK if recipient is a system user
  payment_method    PaymentMethod?
  receipt_file      String? // uploaded receipt filename
  notes             String?
  recorded_by_id    Int
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  recorded_by       User                @relation("ExpenditureRecordedBy", fields: [recorded_by_id], references: [id])
  recipient_user    User?               @relation("ExpenditureRecipient", fields: [recipient_user_id], references: [id])
  server_id         String?
  checksum          String?

  @@index([date])
  @@index([category, date])
  @@index([recorded_by_id])
}

enum ExpenditureCategory {
  SALARY
  SUPPLIES
  MAINTENANCE
  EVENT
  UTILITY
  TRANSPORT
  OTHER
}

// Structured disciplinary measures decided by the Dean of Discipline (and senior staff).
// Optionally links to the underlying DisciplineIssue that triggered the action.
model DisciplinaryAction {
  id                  Int                        @id @default(autoincrement())
  enrollment_id       Int
  discipline_issue_id Int?
  action_type         DisciplinaryActionType
  status              DisciplinaryActionStatus   @default(PENDING)
  days                Int? // for SUSPENSION / SUSPENDED_WITH_CHORES
  start_date          DateTime?
  end_date            DateTime?
  reason              String?
  notes               String?
  decided_by_id       Int
  approval_status     DisciplinaryApprovalStatus @default(NOT_REQUIRED)
  approver_id         Int?
  approved_at         DateTime?
  approval_notes      String?
  created_at          DateTime                   @default(now())
  updated_at          DateTime                   @updatedAt
  enrollment          Enrollment                 @relation(fields: [enrollment_id], references: [id])
  discipline_issue    DisciplineIssue?           @relation(fields: [discipline_issue_id], references: [id])
  decided_by          User                       @relation("DisciplinaryActionDecidedBy", fields: [decided_by_id], references: [id])
  approver            User?                      @relation("DisciplinaryActionApprover", fields: [approver_id], references: [id])
  server_id           String?
  checksum            String?

  @@index([enrollment_id, status])
  @@index([action_type, status])
  @@index([discipline_issue_id])
  @@index([approval_status, approver_id])
}

enum DisciplinaryActionType {
  SUSPENSION
  WORK_DUTY
  SUSPENDED_WITH_CHORES
  PUNISHMENT
  DISMISSAL
  SUSPENDED_DISMISSAL
  END_OF_YEAR_DISMISSAL
  DISCIPLINARY_COUNCIL
}

enum DisciplinaryActionStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DisciplinaryApprovalStatus {
  NOT_REQUIRED
  PENDING_APPROVAL
  APPROVED
  DECLINED
}

// Report request raised by the Dean of Discipline to a Senior Discipline Master
// or Discipline Master. Status flips to OVERDUE once `due_date` passes without
// a submission. Dean dashboards poll the overdue list as the reminder mechanism.
model ReportRequest {
  id                  Int                 @id @default(autoincrement())
  requested_by_id     Int
  requested_from_id   Int
  subject             String
  description         String
  due_date            DateTime
  status              ReportRequestStatus @default(PENDING)
  submitted_at        DateTime?
  submission_notes    String?
  submission_file_url String?
  reviewed_at         DateTime?
  reviewed_notes      String?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  requested_by        User                @relation("ReportRequestRequestedBy", fields: [requested_by_id], references: [id])
  requested_from      User                @relation("ReportRequestRequestedFrom", fields: [requested_from_id], references: [id])
  server_id           String?
  checksum            String?

  @@index([requested_by_id, status])
  @@index([requested_from_id, status])
  @@index([status, due_date])
}

enum ReportRequestStatus {
  PENDING
  SUBMITTED
  REVIEWED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Subject Scheme of Work + Teacher Logbook
// ---------------------------------------------------------------------------
// Scheme of Work owned by VP / Dean of Studies, one per (subject, class, year).
// Teachers record lessons taught against the scheme via LogbookEntry rows that
// reference the actual TeacherPeriod they are timetabled in.
// ---------------------------------------------------------------------------

model SubjectScheme {
  id                    Int            @id @default(autoincrement())
  subject_id            Int
  class_id              Int
  academic_year_id      Int
  periods_per_week      Int
  annual_teaching_hours Int
  notes                 String?
  created_by_id         Int
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  server_id             String?
  checksum              String?
  subject               Subject        @relation(fields: [subject_id], references: [id])
  class                 Class          @relation(fields: [class_id], references: [id])
  academic_year         AcademicYear   @relation(fields: [academic_year_id], references: [id])
  created_by            User           @relation("SubjectSchemeCreatedBy", fields: [created_by_id], references: [id])
  modules               SchemeModule[]

  @@unique([subject_id, class_id, academic_year_id], name: "subject_class_year_unique")
  @@index([academic_year_id])
}

model SchemeModule {
  id                Int             @id @default(autoincrement())
  subject_scheme_id Int
  order             Int
  code              String? // e.g. "MODULE I"
  title             String
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  server_id         String?
  checksum          String?
  subject_scheme    SubjectScheme   @relation(fields: [subject_scheme_id], references: [id], onDelete: Cascade)
  chapters          SchemeChapter[]

  @@unique([subject_scheme_id, order])
  @@index([subject_scheme_id])
}

model SchemeChapter {
  id         Int            @id @default(autoincrement())
  module_id  Int
  order      Int
  code       String? // e.g. "Chapter 3"
  title      String
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
  server_id  String?
  checksum   String?
  module     SchemeModule   @relation(fields: [module_id], references: [id], onDelete: Cascade)
  lessons    SchemeLesson[]

  @@unique([module_id, order])
  @@index([module_id])
}

model SchemeLesson {
  id                         Int             @id @default(autoincrement())
  chapter_id                 Int
  order                      Int
  entry_type                 LessonEntryType @default(LESSON)
  title                      String
  objectives                 String? // Full multi-bullet objectives / sub-topics
  hands_on_activities        String?
  digital_resource_available Boolean         @default(false)
  digital_resources_used     String?
  term_id                    Int?
  week_number                Int? // 1..36
  periods_count              Int             @default(1)
  created_at                 DateTime        @default(now())
  updated_at                 DateTime        @updatedAt
  server_id                  String?
  checksum                   String?
  chapter                    SchemeChapter   @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  term                       Term?           @relation(fields: [term_id], references: [id])
  logbook_entries            LogbookEntry[]

  @@unique([chapter_id, order])
  @@index([chapter_id])
  @@index([term_id, week_number])
}

enum LessonEntryType {
  LESSON
  INTEGRATION
  EVALUATION
  REMEDIATION
  REVISION
  BREAK
}

model LogbookEntry {
  id                Int                @id @default(autoincrement())
  teacher_period_id Int
  lesson_id         Int
  date_taught       DateTime
  status            LogbookEntryStatus @default(COMPLETED)
  notes             String?
  homework_given    String?
  taught_by_id      Int
  reviewed_by_id    Int?
  reviewed_at       DateTime?
  reviewer_notes    String?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  server_id         String?
  checksum          String?
  teacher_period    TeacherPeriod      @relation(fields: [teacher_period_id], references: [id])
  lesson            SchemeLesson       @relation(fields: [lesson_id], references: [id])
  taught_by         User               @relation("LogbookEntryTaughtBy", fields: [taught_by_id], references: [id])
  reviewed_by       User?              @relation("LogbookEntryReviewedBy", fields: [reviewed_by_id], references: [id])

  @@unique([teacher_period_id, date_taught], name: "period_date_unique")
  @@index([taught_by_id, date_taught])
  @@index([lesson_id])
}

enum LogbookEntryStatus {
  COMPLETED
  PARTIAL
  NOT_TAUGHT
}

// ---------- Teacher (per-period) Roll Call ----------
// The teacher takes attendance for their own class each time they teach.
// Keyed on (teacher_period_id, date) so the same weekly period yields a
// distinct record per day. Read access is opened to SDM / Dean of
// Discipline / VP / Principal for oversight.

model TeacherRollCall {
  id                Int      @id @default(autoincrement())
  teacher_period_id Int
  academic_year_id  Int
  date              DateTime
  recorded_by_id    Int
  notes             String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  teacher_period TeacherPeriod          @relation(fields: [teacher_period_id], references: [id])
  academic_year  AcademicYear           @relation(fields: [academic_year_id], references: [id])
  recorded_by    User                   @relation("TeacherRollCallRecordedBy", fields: [recorded_by_id], references: [id])
  entries        TeacherRollCallEntry[]
  server_id      String?
  checksum       String?

  @@unique([teacher_period_id, date])
  @@index([academic_year_id, date])
  @@index([date])
}

model TeacherRollCallEntry {
  id                   Int                   @id @default(autoincrement())
  teacher_roll_call_id Int
  enrollment_id        Int
  status               TeacherRollCallStatus
  linked_absence_id    Int?
  notes                String?
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt

  teacher_roll_call TeacherRollCall @relation(fields: [teacher_roll_call_id], references: [id], onDelete: Cascade)
  enrollment        Enrollment      @relation(fields: [enrollment_id], references: [id])
  linked_absence    StudentAbsence? @relation("TeacherRollCallAbsence", fields: [linked_absence_id], references: [id])
  server_id         String?
  checksum          String?

  @@unique([teacher_roll_call_id, enrollment_id])
  @@index([enrollment_id])
}

enum TeacherRollCallStatus {
  PRESENT
  LATE
  ABSENT
}

// ---------- DM Evaluation of Teacher per Period ----------
// The DM assigned to a sub-class (via RoleAssignment) walks the periods and
// marks the teacher's presence plus behavioural checkboxes: well-dressed,
// class management, punctuality, assiduity. Keyed on (teacher_period_id, date)
// so a weekly timetable slot yields one record per calendar day.

model TeacherPeriodAttendance {
  id                Int                           @id @default(autoincrement())
  teacher_period_id Int
  academic_year_id  Int
  date              DateTime
  status            TeacherPeriodAttendanceStatus
  well_dressed      Boolean                       @default(false)
  class_management  Boolean                       @default(false)
  punctuality       Boolean                       @default(false)
  assiduity         Boolean                       @default(false)
  reason            String?
  notes             String?
  recorded_by_id    Int
  created_at        DateTime                      @default(now())
  updated_at        DateTime                      @updatedAt

  teacher_period TeacherPeriod @relation(fields: [teacher_period_id], references: [id], onDelete: Cascade)
  academic_year  AcademicYear  @relation(fields: [academic_year_id], references: [id])
  recorded_by    User          @relation("TeacherPeriodAttendanceRecordedBy", fields: [recorded_by_id], references: [id])
  server_id      String?
  checksum       String?

  @@unique([teacher_period_id, date])
  @@index([academic_year_id, date])
  @@index([date])
}

enum TeacherPeriodAttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

// ---------- Seized Items ----------
// A DM (or senior discipline role) records an item taken from a student and
// can transfer custody up the chain, typically to the Principal. Transfers
// require the recipient to accept before custody actually changes hands.
// Terminal states: RELEASED (returned to student/parent) or DESTROYED.

model SeizedItem {
  id                   Int              @id @default(autoincrement())
  enrollment_id        Int
  academic_year_id     Int
  item_description     String
  reason               String
  photo_url            String?
  location             String?
  seized_by_id         Int
  seized_at            DateTime         @default(now())
  current_custodian_id Int? // null after release/destroy
  status               SeizedItemStatus @default(IN_CUSTODY)
  released_to_id       Int?
  released_at          DateTime?
  released_notes       String?
  destroyed_at         DateTime?
  destroyed_notes      String?
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt

  enrollment        Enrollment           @relation(fields: [enrollment_id], references: [id])
  academic_year     AcademicYear         @relation(fields: [academic_year_id], references: [id])
  seized_by         User                 @relation("SeizedItemSeizedBy", fields: [seized_by_id], references: [id])
  current_custodian User?                @relation("SeizedItemCustodian", fields: [current_custodian_id], references: [id])
  released_to       User?                @relation("SeizedItemReleasedTo", fields: [released_to_id], references: [id])
  transfers         SeizedItemTransfer[]
  server_id         String?
  checksum          String?

  @@index([enrollment_id, status])
  @@index([current_custodian_id, status])
  @@index([academic_year_id, seized_at])
}

model SeizedItemTransfer {
  id             Int                      @id @default(autoincrement())
  seized_item_id Int
  from_user_id   Int
  to_user_id     Int
  status         SeizedItemTransferStatus @default(PENDING)
  note           String?
  initiated_at   DateTime                 @default(now())
  resolved_at    DateTime?
  resolved_by_id Int?

  seized_item SeizedItem @relation(fields: [seized_item_id], references: [id], onDelete: Cascade)
  from_user   User       @relation("SeizedItemTransferFrom", fields: [from_user_id], references: [id])
  to_user     User       @relation("SeizedItemTransferTo", fields: [to_user_id], references: [id])
  resolved_by User?      @relation("SeizedItemTransferResolvedBy", fields: [resolved_by_id], references: [id])
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  server_id   String?
  checksum    String?

  @@index([seized_item_id, status])
  @@index([from_user_id, status])
  @@index([to_user_id, status])
}

enum SeizedItemStatus {
  IN_CUSTODY
  RELEASED
  DESTROYED
}

enum SeizedItemTransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

// ---------- Personnel Inventory ----------
// Manager maintains a catalog of items and grants stock to personnel.
// Each staff member has their own inventory and can transfer items to
// another staff member; the recipient must accept before it lands.

model InventoryItem {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  description   String?
  unit          String   @default("pcs") // e.g. pcs, box, set, litre
  is_active     Boolean  @default(true)
  created_by_id Int?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  created_by User?               @relation("InventoryItemCreatedBy", fields: [created_by_id], references: [id])
  holdings   InventoryHolding[]
  transfers  InventoryTransfer[]
  ledger     InventoryLedger[]
  server_id  String?
  checksum   String?

  @@index([is_active])
}

model InventoryHolding {
  id         Int      @id @default(autoincrement())
  user_id    Int
  item_id    Int
  quantity   Int      @default(0)
  updated_at DateTime @updatedAt

  user       User          @relation(fields: [user_id], references: [id])
  item       InventoryItem @relation(fields: [item_id], references: [id])
  created_at DateTime      @default(now())
  server_id  String?
  checksum   String?

  @@unique([user_id, item_id])
  @@index([user_id])
  @@index([item_id])
}

model InventoryTransfer {
  id             Int                     @id @default(autoincrement())
  item_id        Int
  from_user_id   Int
  to_user_id     Int
  quantity       Int
  status         InventoryTransferStatus @default(PENDING)
  note           String?
  initiated_at   DateTime                @default(now())
  resolved_at    DateTime?
  resolved_by_id Int?

  item        InventoryItem     @relation(fields: [item_id], references: [id])
  from_user   User              @relation("InventoryTransferFrom", fields: [from_user_id], references: [id])
  to_user     User              @relation("InventoryTransferTo", fields: [to_user_id], references: [id])
  resolved_by User?             @relation("InventoryTransferResolvedBy", fields: [resolved_by_id], references: [id])
  ledger      InventoryLedger[]
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  server_id   String?
  checksum    String?

  @@index([from_user_id, status])
  @@index([to_user_id, status])
  @@index([status, initiated_at])
}

enum InventoryTransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model InventoryLedger {
  id          Int                   @id @default(autoincrement())
  user_id     Int
  item_id     Int
  delta       Int // +credit, -debit
  reason      InventoryLedgerReason
  transfer_id Int?
  actor_id    Int?
  note        String?
  created_at  DateTime              @default(now())

  user       User               @relation("InventoryLedgerUser", fields: [user_id], references: [id])
  item       InventoryItem      @relation(fields: [item_id], references: [id])
  actor      User?              @relation("InventoryLedgerActor", fields: [actor_id], references: [id])
  transfer   InventoryTransfer? @relation(fields: [transfer_id], references: [id])
  updated_at DateTime           @updatedAt
  server_id  String?
  checksum   String?

  @@index([user_id, created_at])
  @@index([item_id, created_at])
}

enum InventoryLedgerReason {
  MANAGER_GRANT
  MANAGER_ADJUST
  TRANSFER_SENT
  TRANSFER_RECEIVED
  TRANSFER_REFUNDED
}

// ---------- Salary Management ----------
// Two personnel salary types:
//   - TEACHER_HOURLY: per-hour rate; net computed from attendance in a pay period.
//   - ADMIN_FIXED:    flat base salary regardless of hours worked in the month.
//
// Workflow: Manager proposes profiles / rate changes / allowances / withholdings
// with reasons; Super Manager validates. Super Manager may also create profiles
// directly (auto-approved). Salaries pay on the last Friday of each month.

model SalaryProfile {
  id               Int                 @id @default(autoincrement())
  user_id          Int
  academic_year_id Int
  salary_type      SalaryType
  hourly_rate      Float? // Required when salary_type = TEACHER_HOURLY
  base_salary      Float? // Required when salary_type = ADMIN_FIXED
  status           SalaryProfileStatus @default(PENDING_APPROVAL)
  notes            String?
  created_by_id    Int
  approved_by_id   Int?
  approved_at      DateTime?
  rejection_reason String?
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  user          User         @relation("SalaryProfileUser", fields: [user_id], references: [id])
  academic_year AcademicYear @relation(fields: [academic_year_id], references: [id])
  created_by    User         @relation("SalaryProfileCreatedBy", fields: [created_by_id], references: [id])
  approved_by   User?        @relation("SalaryProfileApprovedBy", fields: [approved_by_id], references: [id])

  change_requests SalaryChangeRequest[]
  allowances      SalaryAllowance[]
  salary_payments SalaryPayment[]
  server_id       String?
  checksum        String?

  @@unique([user_id, academic_year_id])
  @@index([status])
  @@index([academic_year_id, status])
}

model SalaryChangeRequest {
  id                Int                  @id @default(autoincrement())
  salary_profile_id Int
  old_hourly_rate   Float?
  new_hourly_rate   Float?
  old_base_salary   Float?
  new_base_salary   Float?
  reason            String
  status            SalaryApprovalStatus @default(PENDING)
  requested_by_id   Int
  approved_by_id    Int?
  approved_at       DateTime?
  rejection_reason  String?
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt

  salary_profile SalaryProfile @relation(fields: [salary_profile_id], references: [id], onDelete: Cascade)
  requested_by   User          @relation("SalaryChangeRequestRequestedBy", fields: [requested_by_id], references: [id])
  approved_by    User?         @relation("SalaryChangeRequestApprovedBy", fields: [approved_by_id], references: [id])
  server_id      String?
  checksum       String?

  @@index([status])
  @@index([salary_profile_id])
}

model SalaryAllowance {
  id                Int                  @id @default(autoincrement())
  salary_profile_id Int
  pay_period_id     Int? // If set, allowance applies only to that period; otherwise applies to next generated one.
  type              SalaryAllowanceType
  amount            Float
  reason            String
  status            SalaryApprovalStatus @default(PENDING)
  requested_by_id   Int
  approved_by_id    Int?
  approved_at       DateTime?
  rejection_reason  String?
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt

  salary_profile SalaryProfile @relation(fields: [salary_profile_id], references: [id], onDelete: Cascade)
  pay_period     PayPeriod?    @relation(fields: [pay_period_id], references: [id])
  requested_by   User          @relation("SalaryAllowanceRequestedBy", fields: [requested_by_id], references: [id])
  approved_by    User?         @relation("SalaryAllowanceApprovedBy", fields: [approved_by_id], references: [id])
  server_id      String?
  checksum       String?

  @@index([status])
  @@index([salary_profile_id])
  @@index([pay_period_id])
}

model PayPeriod {
  id               Int             @id @default(autoincrement())
  academic_year_id Int
  year             Int
  month            Int // 1-12 (calendar month the period represents)
  start_date       DateTime
  end_date         DateTime
  pay_date         DateTime // Auto = last Friday of the calendar month
  week_start_dates Json // Array of ISO date strings; manager-assigned weeks to include when computing teacher hours
  status           PayPeriodStatus @default(OPEN)
  notes            String?
  created_by_id    Int
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  academic_year   AcademicYear      @relation(fields: [academic_year_id], references: [id])
  created_by      User              @relation("PayPeriodCreatedBy", fields: [created_by_id], references: [id])
  salary_payments SalaryPayment[]
  allowances      SalaryAllowance[]
  server_id       String?
  checksum        String?

  @@unique([academic_year_id, year, month])
  @@index([status])
}

model SalaryPayment {
  id                Int                 @id @default(autoincrement())
  salary_profile_id Int
  pay_period_id     Int
  user_id           Int
  salary_type       SalaryType
  hours_expected    Float               @default(0) // scheduled hours in period (teachers)
  hours_taught      Float               @default(0) // PRESENT + LATE (teachers)
  hours_absent      Float               @default(0) // ABSENT (teachers)
  hourly_rate       Float? // snapshot at generation time
  base_amount       Float               @default(0) // hourly_rate * hours_taught (teacher) OR base_salary (admin)
  allowance_total   Float               @default(0) // sum of approved ALLOWANCE items
  bonus_total       Float               @default(0) // sum of approved BONUS items
  withheld_amount   Float               @default(0) // total approved withholdings
  net_amount        Float               @default(0) // base + allowance + bonus - withheld
  status            SalaryPaymentStatus @default(DRAFT)
  paid_at           DateTime?
  paid_by_id        Int?
  notes             String?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  salary_profile SalaryProfile       @relation(fields: [salary_profile_id], references: [id])
  pay_period     PayPeriod           @relation(fields: [pay_period_id], references: [id], onDelete: Cascade)
  user           User                @relation("SalaryPaymentUser", fields: [user_id], references: [id])
  paid_by        User?               @relation("SalaryPaymentPaidBy", fields: [paid_by_id], references: [id])
  withholdings   SalaryWithholding[]
  server_id      String?
  checksum       String?

  @@unique([pay_period_id, user_id])
  @@index([status])
  @@index([user_id])
}

model SalaryWithholding {
  id                Int                  @id @default(autoincrement())
  salary_payment_id Int
  scope             WithholdingScope
  amount            Float // For FULL, must equal current net_amount at request time
  reason            String
  status            SalaryApprovalStatus @default(PENDING)
  requested_by_id   Int
  approved_by_id    Int?
  approved_at       DateTime?
  rejection_reason  String?
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt

  salary_payment SalaryPayment @relation(fields: [salary_payment_id], references: [id], onDelete: Cascade)
  requested_by   User          @relation("SalaryWithholdingRequestedBy", fields: [requested_by_id], references: [id])
  approved_by    User?         @relation("SalaryWithholdingApprovedBy", fields: [approved_by_id], references: [id])
  server_id      String?
  checksum       String?

  @@index([status])
  @@index([salary_payment_id])
}

// Cash added to the bursar's account by a Manager or Super Manager
// (e.g., cash top-up outside student fee collection). Counted in the
// cash summary shown to the manager.
model BursarCashInjection {
  id               Int                       @id @default(autoincrement())
  academic_year_id Int
  amount           Float
  source           BursarCashInjectionSource
  reason           String
  reference        String? // optional bank/transaction ref
  injected_by_id   Int
  created_at       DateTime                  @default(now())
  updated_at       DateTime                  @updatedAt

  academic_year AcademicYear @relation(fields: [academic_year_id], references: [id])
  injected_by   User         @relation("BursarCashInjectedBy", fields: [injected_by_id], references: [id])
  server_id     String?
  checksum      String?

  @@index([academic_year_id, created_at])
  @@index([source])
}

enum SalaryType {
  TEACHER_HOURLY
  ADMIN_FIXED
}

enum SalaryProfileStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  REJECTED
}

enum SalaryAllowanceType {
  ALLOWANCE
  BONUS
}

enum SalaryApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayPeriodStatus {
  OPEN
  LOCKED
  PAID
}

enum SalaryPaymentStatus {
  DRAFT
  PENDING_PAYMENT
  WITHHELD
  PAID
}

enum WithholdingScope {
  PARTIAL
  FULL
}

enum BursarCashInjectionSource {
  MANAGER
  SUPER_MANAGER
  OTHER
}

// ---------- Ream (Paper) Stock ----------
// Single central ledger for reams of printing paper.
//   RECEIPT   → stock in (received/purchased) — recorded by Bursar / Manager / Super Manager.
//   ISSUANCE  → stock out (given to a specific person with a reason) — recorded by Bursar / Secretary.
// Current stock = SUM(RECEIPT.quantity) - SUM(ISSUANCE.quantity). Managers & Super Managers read.

model ReamStockLedger {
  id                Int                @id @default(autoincrement())
  type              ReamStockEntryType
  quantity          Int // Number of reams; always positive
  recipient_user_id Int? // Required for ISSUANCE if recipient is a system user
  recipient_name    String? // Free text — used when recipient is external or not a system user
  reason            String? // Required for ISSUANCE
  notes             String?
  recorded_by_id    Int
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  recorded_by User    @relation("ReamStockLedgerRecordedBy", fields: [recorded_by_id], references: [id])
  recipient   User?   @relation("ReamStockLedgerRecipient", fields: [recipient_user_id], references: [id])
  server_id   String?
  checksum    String?

  @@index([type, created_at])
  @@index([recorded_by_id])
  @@index([recipient_user_id])
}

enum ReamStockEntryType {
  RECEIPT
  ISSUANCE
}

// ---------- Tasks ----------
// Manager (or any senior) assigns a task to a staff member; the assignee
// is auto-notified via MobileNotification. Progress is optional 0-100.

model Task {
  id             Int          @id @default(autoincrement())
  title          String
  description    String
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(PENDING)
  category       String       @default("GENERAL") // Free-form label (e.g. MAINTENANCE, ADMIN, REPORT)
  progress       Int          @default(0) // 0-100
  deadline       DateTime?
  assigned_to_id Int
  assigned_by_id Int
  notes          String?
  completed_at   DateTime?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  assigned_to User    @relation("TaskAssignedTo", fields: [assigned_to_id], references: [id])
  assigned_by User    @relation("TaskAssignedBy", fields: [assigned_by_id], references: [id])
  server_id   String?
  checksum    String?

  @@index([assigned_to_id, status])
  @@index([assigned_by_id])
  @@index([deadline])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── Staff loans ────────────────────────────────────────────────────────────
// Any staff member can request a loan and pick a repayment duration in months.
// Super manager approves and picks the repayment method (salary deduction,
// cash, transfer, etc.). Repayments are logged one-by-one against the loan.

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  PAID_OFF
}

enum LoanRepaymentMethod {
  SALARY_DEDUCTION
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  OTHER
}

model StaffLoan {
  id                  Int                  @id @default(autoincrement())
  borrower_id         Int
  amount              Float
  duration_months     Int
  monthly_installment Float // denormalised: amount / duration_months, computed at request time
  reason              String?
  status              LoanStatus           @default(PENDING)
  repayment_method    LoanRepaymentMethod? // null until approved
  approver_id         Int?
  approver_note       String? // rationale on approve, reason on reject
  approved_at         DateTime?
  cancelled_at        DateTime?
  paid_off_at         DateTime?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  borrower   User                 @relation("StaffLoanBorrower", fields: [borrower_id], references: [id])
  approver   User?                @relation("StaffLoanApprover", fields: [approver_id], references: [id])
  repayments StaffLoanRepayment[]
  server_id  String?
  checksum   String?

  @@index([borrower_id])
  @@index([status])
}

model StaffLoanRepayment {
  id             Int                 @id @default(autoincrement())
  loan_id        Int
  amount         Float
  paid_on        DateTime
  method         LoanRepaymentMethod
  notes          String?
  recorded_by_id Int
  created_at     DateTime            @default(now())

  loan        StaffLoan @relation(fields: [loan_id], references: [id], onDelete: Cascade)
  recorded_by User      @relation("StaffLoanRepaymentRecordedBy", fields: [recorded_by_id], references: [id])
  updated_at  DateTime  @updatedAt
  server_id   String?
  checksum    String?

  @@index([loan_id])
}

// ─── Leave requests ─────────────────────────────────────────────────────────
// Any staff member can request time off; super manager approves.

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  BEREAVEMENT
  UNPAID
  OTHER
}

model LeaveRequest {
  id            Int         @id @default(autoincrement())
  requester_id  Int
  leave_type    LeaveType
  start_date    DateTime
  end_date      DateTime
  reason        String
  status        LeaveStatus @default(PENDING)
  approver_id   Int?
  approver_note String?
  decided_at    DateTime?
  cancelled_at  DateTime?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  requester User    @relation("LeaveRequestRequester", fields: [requester_id], references: [id])
  approver  User?   @relation("LeaveRequestApprover", fields: [approver_id], references: [id])
  server_id String?
  checksum  String?

  @@index([requester_id])
  @@index([status])
}
