// Slack-style chat workspace
model ChatChannel {
  id            Int         @id @default(autoincrement())
  name          String
  description   String?
  type          ChannelType
  department    Department?
  subject_id    Int?
  is_private    Boolean     @default(false)
  is_system     Boolean     @default(false)
  created_by_id Int?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  server_id     String?
  checksum      String?

  subject    Subject?            @relation(fields: [subject_id], references: [id])
  created_by User?               @relation("ChatChannelCreatedBy", fields: [created_by_id], references: [id])
  members    ChatChannelMember[]
  messages   ChatMessage[]

  @@unique([type, department])
  @@unique([type, subject_id])
  @@index([type])
}

model ChatChannelMember {
  id           Int        @id @default(autoincrement())
  channel_id   Int
  user_id      Int
  role         MemberRole @default(MEMBER)
  joined_at    DateTime   @default(now())
  last_read_at DateTime?
  muted        Boolean    @default(false)
  updated_at   DateTime   @updatedAt
  server_id    String?
  checksum     String?

  channel ChatChannel @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [user_id], references: [id])

  @@unique([channel_id, user_id])
  @@index([user_id])
}

model ChatMessage {
  id                Int       @id @default(autoincrement())
  channel_id        Int
  sender_id         Int
  content           String
  parent_message_id Int?
  edited_at         DateTime?
  deleted_at        DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  server_id         String?
  checksum          String?

  channel        ChatChannel             @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  sender         User                    @relation("ChatMessageSender", fields: [sender_id], references: [id])
  parent_message ChatMessage?            @relation("ChatThread", fields: [parent_message_id], references: [id])
  replies        ChatMessage[]           @relation("ChatThread")
  reactions      ChatMessageReaction[]
  attachments    ChatMessageAttachment[]
  mentions       ChatMessageMention[]

  @@index([channel_id, created_at])
  @@index([parent_message_id])
}

model ChatMessageMention {
  id         Int      @id @default(autoincrement())
  message_id Int
  user_id    Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  server_id  String?
  checksum   String?

  message ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [user_id], references: [id])

  @@unique([message_id, user_id])
  @@index([user_id])
}

model ChatMessageReaction {
  id         Int      @id @default(autoincrement())
  message_id Int
  user_id    Int
  emoji      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  server_id  String?
  checksum   String?

  message ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [user_id], references: [id])

  @@unique([message_id, user_id, emoji])
}

model ChatMessageAttachment {
  id            Int                @id @default(autoincrement())
  message_id    Int
  file_url      String
  file_name     String
  mime_type     String?
  size_bytes    Int?
  kind          ChatAttachmentKind @default(FILE)
  duration_secs Int? // Duration in seconds for AUDIO kind (voice notes)
  width         Int? // Pixel width for IMAGE kind
  height        Int? // Pixel height for IMAGE kind
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
  server_id     String?
  checksum      String?

  message ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)
}

enum ChatAttachmentKind {
