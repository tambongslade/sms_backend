  @@index([enrollment_id, exam_sequence_id])
  @@index([sub_class_subject_id, exam_sequence_id])
}

// Bell schedule: a named group of periods (e.g. FIRST_CYCLE, SECOND_CYCLE) that
// pins the exact start/end times used by classes assigned to it. Two sets can
// coexist in the same academic year so different groups of classes run
// different rhythms without one global period list clobbering the other.
model PeriodSet {
  id               Int      @id @default(autoincrement())
  code             String // Machine key: FIRST_CYCLE, SECOND_CYCLE, ...
  name             String // Human label
  academic_year_id Int
  description      String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  server_id        String?
  checksum         String?

  academic_year AcademicYear @relation(fields: [academic_year_id], references: [id])
  periods       Period[]
  classes       Class[]

  @@unique([code, academic_year_id])
  @@index([academic_year_id])
}

model Period {
  id               Int             @id @default(autoincrement())
  day_of_week      DayOfWeek
  start_time       String
  end_time         String
  // Retained for backwards compatibility; new callers should read `type`.
  is_break         Boolean         @default(false)
  // TEACHING = billable instructional slot; BREAK = recess (no teacher);
  // PREP = supervised study block outside the teaching grid (e.g. 15:40–17:30).
  // Kept as a discrete field so roll-call / attendance / clash logic can
  // treat PREP separately from a bare break.
  type             PeriodType      @default(TEACHING)
  // Ordinal within the day for its own period_set (1..N). Lets the frontend
  // grid render columns in insertion order without string-sorting names.
  sequence         Int             @default(0)
  name             String
  period_set_id    Int?
  // Timestamps added for sync: getLocalChanges selects on updated_at, so a
  // table without it cannot participate in the sync at all.
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  server_id        String?
  checksum         String?
  period_set       PeriodSet?      @relation(fields: [period_set_id], references: [id])
  teacher_periods  TeacherPeriod[]
  nurse_visit_logs NurseVisitLog[]

  @@unique([day_of_week, start_time, end_time, period_set_id])
  @@index([period_set_id, day_of_week, sequence])
}

enum PeriodType {
  TEACHING
  BREAK
  PREP
}

model TeacherPeriod {
  id               Int              @id @default(autoincrement())
  // Nullable so a timetable slot can carry a subject with no teacher yet
  // ("subject-only slots" in the timetable UI). The VPS has allowed this for a
  // while; this node did not, so all 30 such rows failed every pull with
  // "Argument `academic_year` is missing" — Prisma's way of saying a required
  // FK scalar arrived null, blaming the first relation it then had to demand.
  teacher_id       Int?
  subject_id       Int
  period_id        Int
  academic_year_id Int
  assigned_by_id   Int
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  server_id        String?
  checksum         String?
  sub_class_id     Int
  student_absences StudentAbsence[]
  teacher_absences TeacherAbsence[]
  academic_year    AcademicYear     @relation(fields: [academic_year_id], references: [id])
  assigned_by      User             @relation("TeacherPeriods-AssignedBy", fields: [assigned_by_id], references: [id])
  period           Period           @relation(fields: [period_id], references: [id])
  sub_class        SubClass         @relation(fields: [sub_class_id], references: [id])
  teacher          User?            @relation("TeacherPeriods-Teacher", fields: [teacher_id], references: [id])
  subject          Subject          @relation(fields: [subject_id], references: [id])

  logbook_entries            LogbookEntry[]
  teacher_roll_calls         TeacherRollCall[]
  teacher_period_attendances TeacherPeriodAttendance[]

  // Teacher clashes are now allowed with a warning, so the old
  // (teacher_id, period_id, academic_year_id) uniqueness is dropped.
  // Prevents assigning the same teacher to the same subject in the same period/subclass twice.
  @@unique([teacher_id, subject_id, period_id, sub_class_id, academic_year_id], name: "teacher_subject_subclass_period_unique")
}

