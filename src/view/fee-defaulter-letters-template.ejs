<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title><%= documentTitle %></title>
<style>
    @page {
        size: A4 portrait;
        margin: 10mm;
    }
    * { box-sizing: border-box; }
    body {
        font-family: 'Helvetica', 'Arial', sans-serif;
        color: #111827;
        margin: 0;
        padding: 0;
        font-size: 9pt;
        line-height: 1.35;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    /* One page = 3 stacked, cuttable letter slips. 277mm = 297mm A4 height
       minus the 10mm top/bottom margins set on page.pdf(). */
    .sheet {
        height: 277mm;
        display: flex;
        flex-direction: column;
        page-break-after: always;
    }
    .sheet:last-child { page-break-after: auto; }

    .letter-slot {
        flex: 1 1 33.333%;
        max-height: 33.333%;
        min-height: 0;
        display: flex;
        flex-direction: column;
        padding: 3mm 4mm;
        overflow: hidden;
    }
    .letter-slot + .letter-slot {
        border-top: 1px dashed #9ca3af;
    }

    /* The letterhead image is embedded here ONCE as a CSS rule and reused by
       every slot via this class, instead of a separate <img src="data:...">
       per letter -- repeating a ~28KB base64 string per letter made the HTML
       document (and Puppeteer's render time) scale badly with batch size,
       timing out past 30s for anything more than a handful of letters. */
    <% if (letterhead) { %>
    .letterhead {
        margin-bottom: 5px;
        flex: none;
        height: 32px;
        background-image: url(<%- JSON.stringify(letterhead) %>);
        background-repeat: no-repeat;
        background-position: left center;
        background-size: contain;
    }
    <% } else { %>
    .letterhead { margin-bottom: 5px; flex: none; height: 32px; }
    <% } %>

    .date-line {
        text-align: right;
        font-size: 8pt;
        color: #374151;
        margin-bottom: 6px;
        flex: none;
    }
    .salutation { margin-bottom: 4px; flex: none; }
    .custom-message { margin-bottom: 4px; white-space: pre-wrap; flex: none; }
    .body-text { margin-bottom: 4px; flex: none; }
    .body-text b { color: #111827; }
    .closing { margin-top: 2px; flex: none; }
    .signature { margin-top: 8px; font-weight: 700; flex: none; }
</style>
</head>
<body>
    <%
        function fmt(n) {
            if (n === null || n === undefined) return '0';
            return Number(n).toLocaleString('en-GB');
        }
    %>
    <% pages.forEach(function(group) { %>
        <section class="sheet">
            <% group.forEach(function(l) { %>
                <div class="letter-slot">
                    <div class="letterhead"></div>

                    <div class="date-line"><%= generatedDate %></div>

                    <div class="salutation">Dear Parent,</div>

                    <% if (customMessage) { %>
                        <div class="custom-message"><%= customMessage %></div>
                    <% } %>

                    <div class="body-text">
                        We will like to inform you that your child <b><%= l.studentName %></b> of <b><%= l.className %><% if (l.subClassName) { %> <%= l.subClassName %><% } %></b>
                        is owing <b><%= fmt(l.displayAmount) %> FCFA</b><% if (installmentLabel) { %> for the <b><%= installmentLabel %></b><% } %><% if (dueDateLabel) { %> which was expected before <b><%= dueDateLabel %></b><% } %>.
                        <% if (exclusionDateLabel) { %>Your child will not be allowed on campus as of <b><%= exclusionDateLabel %></b>.<% } %>
                    </div>

                    <div class="closing">Endeavour to pay and send justification of payment.</div>

                    <div class="signature">The Principal</div>
                </div>
            <% }); %>
        </section>
    <% }); %>
</body>
</html>
