<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title><%= documentTitle %></title>
<style>
    @page {
        size: A4 landscape;
        margin: 12mm;
    }
    * { box-sizing: border-box; }
    body {
        font-family: 'Helvetica', 'Arial', sans-serif;
        color: #1f2937;
        margin: 0;
        padding: 0;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
    .page {
        page-break-after: always;
        padding: 1mm 0;
    }
    .page:last-of-type { page-break-after: auto; }

    .letterhead {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #000;
        padding-bottom: 3px;
        margin-bottom: 3px;
        font-size: 6.5pt;
        color: #111827;
    }
    .letterhead .col { width: 34%; text-align: center; line-height: 1.15; }
    .letterhead .col p { margin: 0; }
    .letterhead .col p.bold { font-weight: 700; }
    .letterhead .logo { width: 32%; text-align: center; }
    .letterhead .logo img { max-height: 42px; max-width: 100%; }
    .school-info {
        text-align: center;
        margin: 2px 0 6px 0;
    }
    .school-info h2 {
        margin: 0;
        font-size: 11pt;
        font-weight: 800;
        letter-spacing: 0.3px;
    }
    .school-info .tagline { font-style: italic; font-size: 7.5pt; color: #374151; }
    .school-info .contact { font-size: 7pt; color: #4b5563; }

    .header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        border-bottom: 1.5px solid #1e3a8a;
        padding-bottom: 4px;
        margin-bottom: 6px;
    }
    .header h1 {
        margin: 0;
        font-size: 12pt;
        color: #1e3a8a;
        letter-spacing: 0.3px;
    }
    .header .meta {
        text-align: right;
        font-size: 8pt;
        color: #4b5563;
    }
    .subtitle {
        margin: 0 0 2px 0;
        font-size: 9pt;
        color: #374151;
        font-weight: 600;
    }
    .details {
        margin: 2px 0 4px 0;
        font-size: 8.5pt;
        color: #1f2937;
        line-height: 1.25;
    }
    .details .row { margin: 0; }
    .details .label { font-weight: 700; color: #1e3a8a; }
    .summary {
        display: flex;
        gap: 8px;
        margin-bottom: 6px;
        flex-wrap: wrap;
    }
    .summary .chip {
        background: #eef2ff;
        color: #1e3a8a;
        padding: 2px 8px;
        border-radius: 8px;
        font-size: 8pt;
        font-weight: 600;
    }

    table.timetable {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 9pt;
    }
    table.timetable th, table.timetable td {
        border: 1px solid #cbd5e1;
        padding: 6px 5px;
        vertical-align: middle;
        text-align: center;
        word-wrap: break-word;
    }
    table.timetable thead th {
        background: #1e3a8a;
        color: #ffffff;
        font-weight: 700;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        font-size: 8.5pt;
    }
    table.timetable tbody th {
        background: #f1f5f9;
        color: #0f172a;
        font-weight: 700;
        text-align: left;
        padding-left: 8px;
        font-size: 8.5pt;
    }
    table.timetable tbody th.time {
        background: #f8fafc;
        color: #475569;
        font-weight: 500;
        text-align: center;
        font-size: 8pt;
        font-family: 'Courier New', monospace;
    }
    table.timetable tbody tr:nth-child(even) td { background: #fafafa; }

    .cell-subject { font-weight: 700; color: #111827; display: block; line-height: 1.15; }
    .cell-meta { display: block; font-size: 8pt; color: #4b5563; margin-top: 2px; line-height: 1.15; }
    .cell-empty { color: #9ca3af; font-style: italic; }

    td.type-BREAK {
        background: #fef3c7 !important;
        color: #92400e;
        font-weight: 700;
        letter-spacing: 1px;
    }
    td.type-BREAK.cell-empty { font-style: normal; }

    .footer {
        margin-top: 10px;
        display: flex;
        justify-content: space-between;
        font-size: 8pt;
        color: #6b7280;
    }
</style>
</head>
<body>
<% pages.forEach(function(page) { %>
    <div class="page">
        <div class="letterhead">
            <div class="col">
                <p class="bold">REPUBLIC OF CAMEROON</p>
                <p>MINISTRY OF SECONDARY EDUCATION</p>
                <p>REGIONAL DELEGATION FOR CENTRE</p>
                <p>DIVISIONAL DELEGATION OF MFOUNDI</p>
            </div>
            <div class="logo">
                <% if (schoolLogo) { %><img src="<%= schoolLogo %>" alt="School Logo" /><% } %>
            </div>
            <div class="col">
                <p class="bold">REPUBLIQUE DU CAMEROUN</p>
                <p>MINISTERE DES ENSEIGNEMENTS SECONDAIRES</p>
                <p>DELEGATION REGIONALE DU CENTRE</p>
                <p>DELEGATION DEPARTEMENTALE DU MFOUNDI</p>
            </div>
        </div>
        <div class="school-info">
            <h2><%= schoolName %></h2>
            <% if (schoolTagline) { %><div class="tagline"><%= schoolTagline %></div><% } %>
            <% if (schoolAddress || schoolPhone) { %>
                <div class="contact">
                    <% if (schoolAddress) { %><%= schoolAddress %><% } %>
                    <% if (schoolAddress && schoolPhone) { %> &middot; <% } %>
                    <% if (schoolPhone) { %>Tel: <%= schoolPhone %><% } %>
                </div>
            <% } %>
        </div>

        <div class="header">
            <div>
                <h1><%= page.title %></h1>
                <% if (page.subtitle) { %><div class="subtitle"><%= page.subtitle %></div><% } %>
                <% if (page.details && page.details.length) { %>
                    <div class="details">
                        <% page.details.forEach(function(d) { %>
                            <div class="row"><span class="label"><%= d.label %>:</span> <%= d.value %></div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
            <div class="meta">
                <div><strong>Academic Year:</strong> <%= academicYearName %></div>
                <div><strong>Generated:</strong> <%= generatedAt %></div>
            </div>
        </div>

        <% if (page.chips && page.chips.length) { %>
            <div class="summary">
                <% page.chips.forEach(function(chip) { %>
                    <span class="chip"><%= chip %></span>
                <% }) %>
            </div>
        <% } %>

        <table class="timetable">
            <thead>
                <tr>
                    <th style="width: 12%;">Period</th>
                    <th style="width: 13%;">Time</th>
                    <% page.days.forEach(function(day) { %>
                        <th><%= day.label %></th>
                    <% }) %>
                </tr>
            </thead>
            <tbody>
                <% page.rows.forEach(function(row) { %>
                    <tr>
                        <th><%= row.periodName %></th>
                        <th class="time"><%= row.timeLabel %></th>
                        <% row.cells.forEach(function(cell) { %>
                            <td class="type-<%= cell.type %> <%= cell.entries.length === 0 ? 'cell-empty' : '' %>">
                                <% if (cell.type === 'BREAK') { %>
                                    BREAK
                                <% } else if (cell.entries.length === 0) { %>
                                    &mdash;
                                <% } else { %>
                                    <% cell.entries.forEach(function(entry, idx) { %>
                                        <span class="cell-subject"><%= entry.primary %></span>
                                        <% if (entry.secondary) { %>
                                            <span class="cell-meta"><%= entry.secondary %></span>
                                        <% } %>
                                        <% if (idx < cell.entries.length - 1) { %><hr style="border:none;border-top:1px dashed #cbd5e1;margin:3px 0;" /><% } %>
                                    <% }) %>
                                <% } %>
                            </td>
                        <% }) %>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <div class="footer">
            <div><%= page.footerLeft || '' %></div>
            <div><%= page.footerRight || '' %></div>
        </div>
    </div>
<% }) %>
</body>
</html>
